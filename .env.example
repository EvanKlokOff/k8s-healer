# --- LLM provider ---
# Общий подход: провайдер выбирается через LLM_PROVIDER.
# Ядро не зависит от конкретной модели — только от OpenAI-compatible API.
LLM_PROVIDER=openai_compat        # openai_compat | anthropic (позже)

# Для self-hosted (vLLM, Ollama, TGI, llama.cpp server):
LLM_BASE_URL=http://llm.internal:8000/v1
LLM_API_KEY=sk-local-anything
LLM_MODEL=qwen2.5-14b-instruct    # или llama-3.1-8b-instruct, mistral-nemo

# Для внешнего OpenAI-совместимого (если переключитесь):
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# --- Core ---
REDIS_URL=redis://redis:6379/0
POSTGRES_DSN=postgresql://healer:healer@postgres:5432/healer
DRY_RUN=true
CONFIDENCE_THRESHOLD=0.7
RATE_LIMIT_PER_NODE_PER_HOUR=1
BLAST_RADIUS_MAX_PCT=30

# --- Alerts ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=